<svg width="800" height="600" viewBox="0 0 800 600" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="800" height="600" fill="url(#gradient)"/>
  
  <!-- Decorative Border -->
  <rect x="30" y="30" width="740" height="540" rx="10" stroke="url(#borderGradient)" stroke-width="3" fill="none"/>
  <rect x="45" y="45" width="710" height="510" rx="5" stroke="url(#borderGradient)" stroke-width="1" fill="none"/>
  
  <!-- Title -->
  <text x="400" y="100" font-family="serif" font-size="48" font-weight="bold" fill="#5C2483" text-anchor="middle">
    BENEFACTOR CERTIFICATE
  </text>
  
  <!-- Decorative Line -->
  <line x1="250" y1="130" x2="550" y2="130" stroke="#951B81" stroke-width="2"/>
  
  <!-- Main Text -->
  <text x="400" y="180" font-family="sans-serif" font-size="20" fill="#333" text-anchor="middle">
    This certificate recognizes
  </text>
  
  <!-- Beneficiary Name Placeholder -->
  <rect x="250" y="200" width="300" height="50" rx="5" fill="#F5F5F5" stroke="#E0E0E0" stroke-width="1"/>
  <text x="400" y="230" font-family="serif" font-size="24" font-weight="600" fill="#666" text-anchor="middle">
    Beneficiary Name
  </text>
  
  <!-- From Text -->
  <text x="400" y="280" font-family="sans-serif" font-size="18" fill="#333" text-anchor="middle">
    as a generous benefactor, gifted by
  </text>
  
  <!-- Giver Name Placeholder -->
  <rect x="250" y="295" width="300" height="45" rx="5" fill="#F5F5F5" stroke="#E0E0E0" stroke-width="1"/>
  <text x="400" y="323" font-family="serif" font-size="20" font-weight="500" fill="#666" text-anchor="middle">
    Giver Name
  </text>
  
  <!-- Message -->
  <text x="400" y="380" font-family="sans-serif" font-size="16" fill="#555" text-anchor="middle">
    Your generous donation of
  </text>
  
  <!-- Amount -->
  <circle cx="400" cy="450" r="60" fill="url(#amountGradient)"/>
  <text x="400" y="465" font-family="sans-serif" font-size="36" font-weight="bold" fill="white" text-anchor="middle">
    <tspan>25</tspan>
    <tspan font-size="28">€</tspan>
  </text>
  
  <!-- Footer Message -->
  <text x="400" y="540" font-family="sans-serif" font-size="14" fill="#666" text-anchor="middle">
    helps children in need receive life-changing treatment
  </text>
  
  <!-- Elephant Logo (Simple) -->
  <g transform="translate(60, 480)">
    <circle cx="20" cy="20" r="15" fill="#5C2483" opacity="0.2"/>
    <circle cx="18" cy="18" r="3" fill="#5C2483"/>
    <circle cx="28" cy="18" r="3" fill="#5C2483"/>
    <path d="M 23 25 Q 23 30 20 32" stroke="#5C2483" stroke-width="2" fill="none" stroke-linecap="round"/>
  </g>
  
  <!-- Gradients -->
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FAFAFA;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#FFFFFF;stop-opacity:1" />
    </linearGradient>
    
    <linearGradient id="borderGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5C2483;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#951B81;stop-opacity:1" />
    </linearGradient>
    
    <linearGradient id="amountGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#5C2483;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#951B81;stop-opacity:1" />
    </linearGradient>
  </defs>
</svg>

